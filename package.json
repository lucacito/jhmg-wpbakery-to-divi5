{
  "name": "jhmg-wpbakery-to-divi5",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.44.0"
  },
  "scripts": {
    "test": "./test.sh",
    "test:php": "vendor/bin/phpunit",
    "test:browser": "npx playwright test",
    "assets": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render-assets.ts",
    "i18n": "npm run i18n:free && npm run i18n:pro",
    "i18n:free": "wp i18n make-pot plugin/jhmg-converter-for-wpbakery-to-divi plugin/jhmg-converter-for-wpbakery-to-divi/languages/jhmg-converter-for-wpbakery-to-divi.pot --slug=jhmg-converter-for-wpbakery-to-divi --exclude=vendor,node_modules",
    "i18n:pro": "wp i18n make-pot plugin/jhmg-converter-for-wpbakery-to-divi-pro plugin/jhmg-converter-for-wpbakery-to-divi-pro/languages/jhmg-converter-for-wpbakery-to-divi-pro.pot --slug=jhmg-converter-for-wpbakery-to-divi-pro --exclude=vendor,node_modules"
  }
}
